===================================================================
--- code/game/machinery/machinery.dm	(revision 558)
+++ code/game/machinery/machinery.dm	(working copy)
@@ -47,3 +47,23 @@
 /proc/rate_control(var/S, var/V, var/C, var/Min=1, var/Max=5)
 	var/href = "<A href='?src=\ref[S];rate control=1;[V]"
 	return "[href]=-[Max]'>-</A>[href]=-[Min]'>-</A> [(C?C : 0)] [href]=[Min]'>+</A>[href]=[Max]'>+</A>"
+
+/obj/machinery/proc/flow_to_turf(var/datum/substance/gas/sgas, var/datum/substance/gas/sngas, var/turf/T)
+	if(!sgas || !sngas || !isturf(T)) return
+	var/s_tot = sgas.total()			// pressure of machine gas
+	var/t_tot = T.gas.total() * 0.2		// partial pressure of turf gas
+	var/delta_gt = FLOWFRAC * (t_tot - s_tot / capmult)
+	var/datum/substance/gas/ndelta = new()
+
+	if(delta_gt < 0)	// flow from machinery to turf
+		var/sTotal = sgas.total()
+		if(!sTotal)	return
+		ndelta.copy_all(sgas)
+		ndelta.multiply_gas(-delta_gt/sTotal)	// ndelta contains gas to transfer to turf
+		sngas.sub_delta(ndelta)					// update new gas to remove the amount transfered
+		ndelta.turf_add(T, -1)					// add all of ndelta to turf
+	else
+		sngas.turf_take(T,delta_gt)				// flow from turf to pipe
+
+	T.reset_phases()	// update turf gas vars for both cases
+
