+/area/proc/atmosalert(var/state)
+	if (state != atmos)
+		// change in atmos state
+		atmos = state
+		var/list/cameras = list()
+		for (var/obj/machinery/camera/C in src)
+			cameras += C
+		for (var/mob/ai/aiPlayer in world)
+			if (state == 1)
+				aiPlayer.cancelAlarm("Atmosphere", src, null)
+			else
+				aiPlayer.triggerAlarm("Atmosphere", src, cameras)
+	return
+
+/area/proc/poweralert(var/state)
+	if (state != poweralm)
+		poweralm = state
+		var/list/cameras = list()
+		for (var/obj/machinery/camera/C in src)
+			cameras += C
+		for (var/mob/ai/aiPlayer in world)
+			if (state == 1)
+				aiPlayer.cancelAlarm("Power", src, null)
+			else
+				aiPlayer.triggerAlarm("Power", src, cameras)
+	return
+
