 	call_shuttle_proc(usr)
 
+/mob/ai/proc/ai_alerts()
+	set category = "AI Commands"
+	set name = "Show Alerts"
+
+	var/dat = "<HEAD><TITLE>Current Station Alerts</TITLE></HEAD><BODY>\n"
+	for (var/cat in src.alarms)
+		dat += text("<B>[]</B><BR>\n", cat)
+		var/list/L = src.alarms[cat]
+		if (L.len)
+			for (var/alarm in L)
+				var/list/alm = L[alarm]
+				var/area/A = alm[1]
+				var/obj/machinery/camera/C = alm[2]
+				if (C && C.status)
+					dat += text("-- [] (<A HREF=?src=\ref[];switchcamera=\ref[]>Camera</A>)<BR>\n", A.name, src, C)
+				else
+					dat += text("-- [] (No Camera)<BR>\n", A.name)
+		else
+			dat += "-- All Systems Nominal<BR>\n"
+		dat += "<BR>\n"
+
+	usr << browse(dat, "window=aialerts")
+
 /mob/ai/proc/ai_camera_track()
 	set category = "AI Commands"
 	set name = "Track With Camera"
