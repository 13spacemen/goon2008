+/obj/machinery/computer/communications/process()
+
+	if(stat & (NOPOWER|BROKEN) )
+		return
+	use_power(250)
+	src.updateDialog()
+	return
+
+/obj/machinery/computer/communications/interact(var/mob/user as mob)
+
+	user.machine = src
+	var/dat
+	dat = "<B>Communications Console</B><HR><TT>"
+	if (src.temp)
+		dat += "[src.temp]<BR>\n<A href='?src=\ref[user];mach_close=computer'>Close</A>"
+	else
+		if (!ticker.timeleft)
+			dat += "<B>Emergency shuttle</B>\n<BR>\nETA: 10:00<BR><A href='?src=\ref[src];call=1'>\[Call shuttle\]</A><BR>"
+		else if (ticker.timing == 1)
+			dat += "<B>Emergency shuttle</B>\n<BR>\nETA: [ticker.timeleft / 600 % 60]:[ticker.timeleft / 100 % 6][ticker.timeleft / 10 % 10]<BR>\n<A href='?src=\ref[src];return=1'>\[Cancel call\]</A><BR>"
+		else
+			dat += "<B>Emergency shuttle</B>\n<BR>\nETA: [ticker.timeleft / 600 % 60]:[ticker.timeleft / 100 % 6][ticker.timeleft / 10 % 10]<BR>\n<A href='?src=\ref[src];call=1'>\[Call shuttle\]</A><BR>"
+		if (interceptlog)
+			dat += "<BR>\n<B>Intercepted syndicate transmission</B>\n<BR><A href='?src=\ref[src];showlog=1'>\[Display log\]</A><BR>"
+		dat += "<BR>\n<A href='?src=\ref[user];mach_close=computer'>Close</A>"
+
+	user << browse(dat, "window=computer;size=400x500")
+	return
+
+/obj/machinery/computer/communications/Topic(href, href_list)
+	. = ..()
+	if(!.) return
+	if(stat & (NOPOWER|BROKEN))
+		usr << browse(null, "window=computer")
+		return
+	var/mob/carbon/M = usr
+	if ((!usr.can_use_hands()))
+		return
+
+	if ((get_dist(src, usr) > 1 || !istype(src.loc, /turf)) && !istype(usr, /mob/silicon/ai))
+		usr << browse(null, "window=computer")
+		return
+	usr.machine = src
+	if (href_list["call"])
+		src.temp = "Confirm distress signal<BR><BR><B><A href='?src=\ref[src];call2=1'>\[Swipe ID to send distress signal\]</A></B><BR><A href='?src=\ref[src];temp=1'>Cancel</A><BR>"
+	else if (href_list["call2"])
+		if(!istype(usr, /mob/carbon))
+			return
+		var/obj/item/weapon/card/id/I = M.equipped()
+		if (istype(I))
+			if(src.check_access(I))
+				call_shuttle_proc(usr)
+				src.temp = null
+			else
+				src.temp = "<B>Access denied</B><BR><BR><BR><A href='?src=\ref[src];temp=1'>Cancel</A><BR>"
+	else if (href_list["return"])
+		cancel_call_proc(usr)
+	else if (href_list["showlog"])
+		src.temp = "<BR>[src.interceptlog]<BR><A href='?src=\ref[src];deletelog=1'>Delete log</A>\n<BR><A href='?src=\ref[src];temp=1'>Cancel</A><BR>"
+	else if (href_list["deletelog"])
+		interceptlog = null
+		src.temp = "Log deleted\n<BR><A href='?src=\ref[src];temp=1'>Return</A><BR>"
+	else if (href_list["temp"])
+		src.temp = null
+
+
 	src.add_fingerprint(usr)
-	if(stat & NOPOWER) return
-	call_shuttle_proc(usr)
+	for(var/mob/MM in viewers(1, src))
+		if ((MM.client && MM.machine == src))
+			src.interact(MM)
+	return
 
