+/mob/ai/proc/lockdown()
+	set category = "AI Commands"
+	set name = "Lockdown"
+
+	world << "\red Lockdown initiated by [usr.name]!"
+
+	for(var/obj/machinery/firealarm/FA in world)
+		spawn( 0 )
+			FA.alarm()
+
+	usr << "\red Lockdown command removed for 10 seconds."
+	src.verbs -= /mob/ai/proc/lockdown
+	sleep(100) //wait 10 seconds so the faggots dont spam it
+	src.verbs += /mob/ai/proc/lockdown
+	usr << "\red Lockdown command re-enabled."
+
+/mob/ai/proc/disablelockdown()
+	set category = "AI Commands"
+	set name = "Disable Lockdown"
+
+	world << "\red Lockdown cancelled by [usr.name]!"
+
+	for(var/obj/machinery/firealarm/FA in world)
+		spawn( 0 )
+			FA.reset()
+
+	usr << "\red Disable lockdown command removed for 10 seconds."
+	src.verbs -= /mob/ai/proc/disablelockdown
+	sleep(100) //wait 10 seconds so the faggots dont spam it
+	src.verbs += /mob/ai/proc/disablelockdown
+	usr << "\red Disable lockdown command re-enabled."
+
 /mob/ai/proc/ai_camera_list()
 	set category = "AI Commands"
 	set name = "Show Camera List"
