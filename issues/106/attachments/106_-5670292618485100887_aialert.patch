 	return
 
+/mob/ai/proc/triggerAlarm(var/class, area/A, obj/machinery/camera/C=null)
+	if (stat == 2)
+		return
+	var/list/L = src.alarms[class]
+	for (var/I in L)
+		if (I == A.name) return 1
+	L[A.name] = list(A, C)
+	if (C && C.status)
+		src << text("--- [] alarm detected in <A HREF=?src=\ref[];switchcamera=\ref[]>[]</A>!", class, src, C, A.name)
+	else
+		src << text("--- [] alarm detected in []!", class, A.name)
+	return 0
+
+
+/mob/ai/proc/cancelAlarm(var/class, area/A as area)
+	var/list/L = src.alarms[class]
+	for (var/I in L)
+		if (I == A.name)
+			L -= I
+	src << text("--- [] alarm in [] has been cleared.", class, A.name)
+	return 0
+
