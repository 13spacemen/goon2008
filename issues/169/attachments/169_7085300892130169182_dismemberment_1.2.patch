+		face.Blend(haircolor_rgb(M.hair_color), ICON_ADD)
+		skin.Blend(face, 3)
+		src.name = "[M.body_name]'s severed head"
+	skin.Blend(new /icon('humansevered.dmi', text("[]_blood",icon_state)),3)	// Blooood
+	src.icon = skin
