Index: code/game/items.dm
===================================================================
--- code/game/items.dm	(revision 576)
+++ code/game/items.dm	(working copy)
@@ -577,6 +577,38 @@
 			//Foreach goto(160)
 	return
 
+/obj/item/weapon/flamethrower/attackby(obj/item/weapon/tank/plasmatank/W as obj, mob/user as mob)
+	if(!istype(W,/obj/item/weapon/tank/plasmatank)) return ..()
+//	src.icon_state = "flamethrower_loaded"
+	attached = W
+
+/obj/item/weapon/flamethrower/Topic(href,href_list[])
+	if(href_list["close"])
+		usr << ss13_browse(null, "window=tank")
+		return
+	var/obj/item/weapon/flamethrower/F = locate(href_list["src"])
+	F.throw_amount = dd_range(1,25000,F.throw_amount + text2num(href_list["amount"]))
+	for(var/mob/M in viewers(1, F.loc))
+		if(M.client && M.machine == F)
+			F.attack_self(M)
+
+/obj/item/weapon/flamethrower/attack_self(mob/user as mob)
+	if(!src.attached) return
+	user.machine = src
+	var/dat = text({"<TT><B>Flamethrower</B><BR>
+					Amount in tank / Capacity of tank: [src.attached.gas.total()] / [src.attached.maximum]<BR>
+					Amount to throw: [rate_control(src,"amount",src.throw_amount,15,300,3000)]
+					<A HREF='?src=\ref[src];close=1'>Close</A></TT>"})
+	user << browse(dat, "window=tank;size=600x300")
+
+/obj/item/weapon/flamethrower/proc/flame_turf(turf/T as turf, obj/item/weapon/flamethrower/F as obj)
+	if(!F.attached) return
+	if(F.attached.gas.plasma < F.throw_amount)
+		F.throw_amount = F.attached.gas.plasma
+		usr << "Your flamethrower sputters!"
+	T.gas.transfer_from(F.attached.gas,F.throw_amount)
+	T.firelevel += F.throw_amount*100
+
 /obj/item/weapon/syndicate_uplink/proc/explode()
 
 	var/turf/T = get_turf(src.loc)
