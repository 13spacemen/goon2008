+/client/proc/AIMove(n,direct,var/mob/silicon/ai/M)
+{
+	if(!M.current) return	//	current camera selected (terrible name)
+
+	var/min_dist = 1e8
+	var/obj/machinery/camera/N = null
+	var/obj/machinery/camera/C = M.current
+	for(var/obj/machinery/camera/T in world)
+		if(M.network != C.network)	continue	//	different network (syndicate)
+		if(C.z != T.z)				continue	//	different viewing plane
+		if(!T.status)				continue	//	ignore disabled cameras
+		if(direct & NORTH)
+			if(T.y <= C.y)			continue
+			if(abs(T.x-C.x)>5)		continue
+			var/distance = T.y-C.y
+			if(min_dist<= distance) continue
+			min_dist = distance
+			N = T
+		if(direct & SOUTH)
+			if(T.y >= C.y)			continue
+			if(abs(T.x-C.x)>5)		continue
+			var/distance = C.y-T.y
+			if(min_dist<= distance) continue
+			min_dist = distance
+			N = T
+		if(direct & EAST)
+			if(T.x <= C.x)			continue
+			if(abs(T.y-C.y)>5)		continue
+			var/distance = T.x-C.x
+			if(min_dist<= distance) continue
+			min_dist = distance
+			N = T
+		if(direct & WEST)
+			if(T.x >= C.x)			continue
+			if(abs(T.y-C.y)>5)		continue
+			var/distance = C.x-T.x
+			if(min_dist<= distance) continue
+			min_dist = distance
+			N = T
+
+	if(!N)	return
+	M.switchCamera(N)
+}
