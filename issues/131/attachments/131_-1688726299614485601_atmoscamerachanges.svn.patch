@@ -690,6 +691,14 @@
 
 	return
 
+/obj/machinery/alarm/attackby(W as obj, user as mob)
+	if (istype(W, /obj/item/weapon/wirecutters))
+		stat ^= BROKEN
+		for(var/mob/O in viewers(user, null))
+			O.show_message(text("\red [] has []activated []!", user, (stat&BROKEN) ? "de" : "re", src), 1)
