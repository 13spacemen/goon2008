 	var/turf/T = src.loc
 	var/area/A = T.loc
+	var/safe = 2
 
-	if(stat & NOPOWER)
+	if(stat & (NOPOWER|BROKEN))
 		icon_state = "alarm-p"
+		A.atmosalert(safe, src)
 		return
 
 	use_power(5, ENVIRON)
 
-	var/safe = 2
 	if (!( istype(T, /turf) ))
 		return
