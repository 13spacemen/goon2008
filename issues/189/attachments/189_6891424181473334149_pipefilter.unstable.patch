--- code/game/newpipe.dm	(revision 361)
+++ code/game/newpipe.dm	(working copy)
@@ -878,9 +878,165 @@
 	//	delta = 0
 
 
+// *** pipe filter
 
 
+/obj/machinery/pipefilter/New()
 
+	..()
+
+	switch(dir)
+		if(NORTH)
+			p_dir = 13 //NORTH|EAST|WEST
+
+		if(SOUTH)
+			p_dir = 14 //SOUTH|EAST|WEST
+
+		if(EAST)
+			p_dir = 7 //EAST|NORTH|SOUTH
+
+		if(WEST)
+			p_dir = 11 //WEST|NORTH|SOUTH
+
+
+
+	src.gas = new /obj/substance/gas( src )
+	src.gas.maximum = src.capacity
+	src.ngas = new /obj/substance/gas()
+	gasflowlist += src
+
+
+/obj/machinery/pipefilter/buildnodes()
+
+	var/turf/T = src.loc
+
+	node3 = get_machine( level, T, dir )		// the injector port
+
+	n1dir = turn(dir, 90)
+	n2dir = turn(dir,-90)
+
+	node1 = get_machine( level, T , n1dir )	// the main flow dir
+	node2 = get_machine( level, T , n2dir )
+
+	if(node1) vnode1 = node1.getline()
+	if(node2) vnode2 = node2.getline()
+	if(node3) vnode3 = node3.getline()
+
+	return
+
+
+/obj/machinery/pipefilter/gas_flow()
+	gas.replace_by(ngas)
+
+/obj/machinery/pipefilter/process()
+	var/delta_gt
+
+	if(vnode1)
+		delta_gt = FLOWFRAC * ( vnode1.get_gas_val(src) - gas.tot_gas() / capmult)
+		calc_delta( src, gas, ngas, vnode1, delta_gt)
+	else
+		leak_to_turf(1)
+
+	if(vnode2)
+		delta_gt = FLOWFRAC * ( vnode2.get_gas_val(src) - gas.tot_gas() / capmult)
+		calc_delta( src, gas, ngas, vnode2, delta_gt)
+	else
+		leak_to_turf(2)
+
+	//if(vnode3)
+	//	delta_gt = FLOWFRAC * ( vnode3.get_gas_val(src) - gas.tot_gas() / capmult)
+	//	calc_delta( src, gas, ngas, vnode3, delta_gt)
+	//else
+	//	leak_to_turf(3)
+	// don't leak to vnode3- this is the filtered node
+
+	// figure out how much to leak to vnode3 based on the filter
+	if (vnode3)
+		var/obj/substance/gas/ndelta = src.get_delta()
+		ngas.sub_delta(ndelta)
+	else
+		leak_to_turf(3)
+
+/obj/machinery/pipefilter/proc/get_delta()
+	var/obj/substance/gas/ndelta = new()
+	if (src.f_mask & GAS_O2)
+		ndelta.oxygen = min(src.f_per, src.gas.oxygen)
+	if (src.f_mask & GAS_N2)
+		ndelta.n2 = min(src.f_per, src.gas.n2)
+	if (src.f_mask & GAS_PL)
+		ndelta.plasma = min(src.f_per, src.gas.plasma)
+	if (src.f_mask & GAS_CO2)
+		ndelta.co2 = min(src.f_per, src.gas.co2)
+	if (src.f_mask & GAS_N2O)
+		ndelta.sl_gas = min(src.f_per, src.gas.sl_gas)
+	return ndelta
+
+
+/obj/machinery/pipefilter/get_gas_val(from)
+	return gas.tot_gas()/capmult
+
+/obj/machinery/pipefilter/get_gas(from)
+	return gas
+
+
+/obj/machinery/pipefilter/proc/leak_to_turf(var/port)
+
+	var/turf/T
+
+
+	switch(port)
+		if(1)
+			T = get_step(src, n1dir)
+		if(2)
+			T = get_step(src, n2dir)
+		if(3)
+			T = get_step(src, dir)
+			if(T.density)
+				T = src.loc
+				if(T.density)
+					return
+			// custom flow- dump the current delta to turf, no backflow allowed
+			var/obj/substance/gas/ndelta = src.get_delta()
+			ngas.sub_delta(ndelta)
+			ndelta.turf_add(T, -1)
+			return
+
+	if(T.density)
+		T = src.loc
+		if(T.density)
+			return
+
+	flow_to_turf(gas, ngas, T)
+
+	//	delta = 0
+
+// pipefilter interact/topic
+
+/obj/machinery/pipefilter/interact(mob/user as mob)
+	var/list/gases = list("O2", "N2", "Plasma", "CO2", "N2O")
+	user.machine = src
+	var/dat = "Filter Extraction Rate:<BR>\n<A href='?src=\ref[src];fp=-[num2text(1000000.0, 7)]'>M</A> <A href='?src=\ref[src];fp=-10000'>-</A> <A href='?src=\ref[src];fp=-1000'>-</A> <A href='?src=\ref[src];fp=-100'>-</A> <A href='?src=\ref[src];fp=-1'>-</A> [src.f_per] <A href='?src=\ref[src];fp=1'>+</A> <A href='?src=\ref[src];fp=100'>+</A> <A href='?src=\ref[src];fp=1000'>+</A> <A href='?src=\ref[src];fp=10000'>+</A> <A href='?src=\ref[src];fp=[num2text(1000000.0, 7)]'>M</A><BR>\n"
+	for (var/i = 1; i <= gases.len; i++)
+		dat += "[gases[i]]: <A HREF='?src=\ref[src];tg=[1 << (i - 1)]'>[(src.f_mask & 1 << (i - 1)) ? "Extracting" : "Passing"]</A><BR>\n"
+	user << browse(dat, "window=pipefilter;size=600x300")
+
+/obj/machinery/pipefilter/Topic(href, href_list)
+	..()
+	if (!usr.can_use_hands())
+		return
+	if (((get_dist(src, usr) <= 1 || istype(usr, /mob/silicon/ai)) && istype(src.loc, /turf)))
+		usr.machine = src
+		if (href_list["fp"])
+			src.f_per = min(max(round(src.f_per + text2num(href_list["fp"])), 0), 1000000.0)
+		else if (href_list["tg"])
+			// toggle gas
+			src.f_mask ^= text2num(href_list["tg"])
+		
+		src.updateUsrDialog()
+		src.add_fingerprint(usr)
+	else
+		usr << browse(null, "window=pipefilter")
+
