+				dat += "</NOBR><BR>\n"
+		else
+			dat += "-- All Systems Nominal<BR>\n"
+		dat += "<BR>\n"
+
+	src.viewalerts = 1
+	src << browse(dat, "window=aialerts&can_close=0")
