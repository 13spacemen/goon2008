+	rname = "r_leg"
+	force = 15
+/obj/item/weapon/limb/l_leg
+	name = "severed left leg"
+	desc = "A severed left leg"
+	icon_state = "l_leg"
+	rname = "l_leg"
+	force = 15
+/obj/item/weapon/limb/r_leg_stump
+	name = "severed right leg stump"
+	desc = "A severed right leg without a foot"
+	icon_state = "r_leg_stump"
+	rname = "r_leg_stump"
+	force = 12
+/obj/item/weapon/limb/l_leg_stump
+	name = "severed left leg stump"
+	desc = "A severed left leg without a foot"
+	icon_state = "l_leg_stump"
+	rname = "l_leg_stump"
+	force = 12
+/obj/item/weapon/limb/r_foot
+	name = "severed right foot"
+	desc = "A severed right foot"
+	icon_state = "r_foot"
+	rname = "r_foot"
+	force = 3
+/obj/item/weapon/limb/l_foot
+	name = "severed left foot"
+	desc = "A severed left foot"
+	icon_state = "l_foot"
+	rname = "l_foot"
+	force = 3
+/obj/item/weapon/limb/head
+	name = "severed head"
+	desc = "A severed head"
+	icon_state = "head"
+	rname = "head"
+	force = 7
+	skintone = 0.0
+	var/icon/face
+
+/obj/item/weapon/storage/toolbox/attack(mob/carbon/M as mob, mob/carbon/user as mob)	// toolbox knockout script for severed heads
+
+	..()
+	if ((prob(30) && !M.is_dead))
+		var/mob/carbon/H = M
+
+		// ******* Check
+
+		if ((istype(H, /mob/carbon) && istype(H, /obj/item/weapon/clothing/head) && H.flags & 8 && prob(80)))
+			M << "\red The helmet protects you from being hit hard in the head!"
+			return
+		var/time = rand(1, 5)
+		if (prob(90))
+			M.knockout_until(time)
+		else
+			M.knockdown_until(time)
+		user.show_viewers(text("\red <B>[] has been knocked unconscious!</B>", M))
+	return
+
+/obj/item/weapon/limb/proc/haircolor_rgb(color)
+	if(color == "grey")
+		return rgb(200,200,200)
+	else if(color == "black")
+		return rgb(255,255,255)
+
+/obj/item/weapon/limb/proc/update_skin(rname)
+	var/icon/skin = new /icon( 'humansevered.dmi', rname )
+	if (src.skintone == "medium")			// this has not really been tested, as skintone doesn't work atm.
+		skin.Blend(rgb(100,100,100), 0)
+	else if(src.skintone == "dark")
+		skin.Blend(rgb(200,200,200), 0)
+	skin.Blend(new /icon('humansevered.dmi', text("[]_blood",rname)),3)	// Blooood
+	src.icon = skin
+
+/obj/item/weapon/limb/head/proc/update_head()
+	var/icon/skin = new /icon( 'humansevered.dmi', "head" )
+	if (src.skintone == "medium")
+		skin.Blend(rgb(100,100,100), 0)
+	else if(src.skintone == "dark")
+		skin.Blend(rgb(200,200,200), 0)
+	var/icon/face = new /icon('mob.dmi', "[src.hairstyle]2")
+	face.Blend(haircolor_rgb(src.haircolor), 0)
+	skin.Blend(face, 3)
+	skin.Blend(new /icon('humansevered.dmi', "head_blood"),3)
+	src.icon = skin
+
