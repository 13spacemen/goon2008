+/obj/machinery/valve/dvalve/attackby(obj/item/weapon/S as obj, mob/user as mob)
+	if(istype(S, /obj/item/weapon/screwdriver))
+		if(!p_open) icon_state = "dvalve-[open?"awires":"wires"]"
+		else icon_state = "dvalve[open?"1":"0"]"
