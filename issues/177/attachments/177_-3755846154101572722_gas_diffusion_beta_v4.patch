@@ -133,411 +133,154 @@
 	..()
 	return
 
-
-
-
-/* --------------------------
-
-heat = amount * temperature(abs)
-
-heat is conserved between exchanges
-
----------------------------- */
-
-//fractional multipliers of heat
+//----------------------------------------------------------------------------
+//--	Gas Processing - reorganized by Kelson
+//----------------------------------------------------------------------------
+//--	Heat = temp(absolute) * amount
+//--	Heat is conserved between gas exchanges
+//----------------------------------------------------------------------------
+//--	fractional multipliers of heat
 #define TURF_ADD_FRAC 0.95		//cooling due to release of gas into tile
 #define TURF_TAKE_FRAC 1.06		//heating due to pressurization into pipework
+//----------------------------------------------------------------------------
+/datum/substance/gas/proc/clear()				{	oxygen = 0;	plasma = 0;	no2 = 0;	co2 = 0; nitrogen = 0		}
+/datum/substance/gas/proc/total()				{	return (co2 + oxygen + plasma + no2 + nitrogen)					}
+/datum/substance/gas/proc/add_gas(C,N,O,P,S)	{	co2 += C; nitrogen += N; oxygen += O; plasma += P; no2 += S;	}
+/datum/substance/gas/proc/rem_gas(C,N,O,P,S)	{	co2 -= C; nitrogen -= N; oxygen -= O; plasma -= P; no2 -= S;	}
